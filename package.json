{
  "name": "dsh-mcp-toggle",
  "version": "0.1.0",
  "description": "Per-session MCP selection for DeepSeek Harness, off by default",
  "type": "module",
  "main": "bootstrap.js",
  "exports": {
    ".": "./bootstrap.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": ["bootstrap.js", "release.json", "dist", "lib/client.js", "cordis.patch.yml"],
  "scripts": { "build": "node scripts/build.mjs" },
  "license": "MIT",
  "repository": { "type": "git", "url": "https://github.com/YanzuoLu/dsh-mcp-toggle.git" },
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": {
      "platform": "web",
      "inject": ["@deepseek-ai/dsh-client-ui-conversation", "@deepseek-ai/dsh-client-ui-permission-presets"]
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.0.4",
    "@deepseek-ai/dsh-tools": "0.2.0-rc.2",
    "@deepseek-ai/dsh-mcp-resources": "0.2.0-rc.2",
    "@deepseek-ai/dsh-storage-domain": "0.2.0-rc.2",
    "zod": "^4.0.0"
  }
}
